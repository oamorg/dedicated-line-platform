# MySQL connection string
# URL-encode reserved characters in the database password.
DATABASE_URL=mysql+pymysql://dedicated_line:CHANGE_ME@127.0.0.1:3306/dedicated_line?charset=utf8mb4

# API runtime
API_HOST=127.0.0.1
API_PORT=8000
IMPORT_DATA_DIR=./data/excel
# API workers and CLI must use the SAME absolute local path in production.
# IMPORT_LOCK_FILE=/opt/dedicated-line/logs/imports/.import.lock

# Auth
PBKDF2_ITERATIONS=240000
SESSION_TTL_HOURS=12
